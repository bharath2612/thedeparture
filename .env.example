# ── Air (flights) ─────────────────────────────────────────────────
# Duffel, the no-IATA launch rail. It issues tickets on its OWN airline
# relationships, so this is the only supplier here that can actually close a
# flight booking. Self-serve signup at duffel.com.
#   duffel_test_…  → live API, test airlines, no money moves
#   duffel_live_…  → real tickets, real money
DUFFEL_TOKEN=

# Amadeus Self-Service, SHOP ONLY. Free key at developers.amadeus.com.
# A second price on the same flight is what makes "cheapest of N" real on air,
# but it has no ticketing authority and can never be handed a booking.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=test.api.amadeus.com

# Travelport TripServices (JSON Air v11), SHOP ONLY.
# A real GDS: Galileo content priced natively in INR on an APAC:India access
# group. It returns genuine fares for the India corridor, which is what lets
# ENABLE_DEMO_AIR go off. It CANNOT ticket for us: a GDS plates against an
# accredited agency's own PCC, and K Global Travels LLP's IATA accreditation is
# applied for, not held. Until it lands (then Travelport certification), the
# adapter implements no book() and `bookable` stays false.
# Auth is an OAuth2 PASSWORD grant: user credentials AND client id/secret.
TRAVELPORT_USERNAME=
TRAVELPORT_PASSWORD=
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_ACCESS_GROUP=
# Pre-production by default. Production hosts drop the `.pp`.
TRAVELPORT_HOST=api.pp.travelport.net
TRAVELPORT_AUTH_HOST=auth.pp.travelport.net

# ── Hotels ────────────────────────────────────────────────────────
# Blank => public sandbox key (test data). Paste sand_… or prod_… to use yours.
LITEAPI_KEY=

# Additional hotel aggregators (onboard = key + implement adapter)
REZLIVE_KEY=
RATEHAWK_KEY=
TBO_KEY=

# ── Rate-shop / pricing ───────────────────────────────────────────
DEFAULT_MARKUP_PCT=15        # your margin, applied to the cheapest net
DEFAULT_CURRENCY=AED

# Synthetic hotel supplier to VISUALISE the cheapest-picker before real
# suppliers are keyed. Fake rates, clearly labelled, not bookable. Turn off for
# anything real.
ENABLE_DEMO_SUPPLIER=false

# Synthetic AIR suppliers (two, so cheapest-of-N is visible). Invented fares,
# shop-only, never bookable. Off for anything real.
ENABLE_DEMO_AIR=false

# ── Ops view ───────────────────────────────────────────────────────────────
# Supplier net cost, our margin, and the per-supplier quote comparison. Useful
# on a rate-shop console; wrong on a customer's screen. Default OFF, so a
# deploy that configures nothing cannot publish our cost base. Set true locally.
SHOW_OPS_PRICING=false
