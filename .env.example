# ── Air (flights) ─────────────────────────────────────────────────
# Duffel — the no-IATA launch rail. It issues tickets on its OWN airline
# relationships, so this is the only supplier here that can actually close a
# flight booking. Self-serve signup at duffel.com.
#   duffel_test_…  → live API, test airlines, no money moves
#   duffel_live_…  → real tickets, real money
DUFFEL_TOKEN=

# Amadeus Self-Service — SHOP ONLY. Free key at developers.amadeus.com.
# A second price on the same flight is what makes "cheapest of N" real on air,
# but it has no ticketing authority and can never be handed a booking.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=test.api.amadeus.com

# ── Hotels ────────────────────────────────────────────────────────
# Blank => public sandbox key (test data). Paste sand_… or prod_… to use yours.
LITEAPI_KEY=

# Additional hotel aggregators (onboard = key + implement adapter)
REZLIVE_KEY=
RATEHAWK_KEY=
TBO_KEY=

# ── Rate-shop / pricing ───────────────────────────────────────────
DEFAULT_MARKUP_PCT=15        # your margin, applied to the cheapest net
DEFAULT_CURRENCY=AED

# Synthetic hotel supplier to VISUALISE the cheapest-picker before real
# suppliers are keyed. Fake rates, clearly labelled, not bookable. Turn off for
# anything real.
ENABLE_DEMO_SUPPLIER=false
